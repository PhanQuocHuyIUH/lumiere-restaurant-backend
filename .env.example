# ---------- Spring multipart limits ----------
SPRING_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_MULTIPART_MAX_REQUEST_SIZE=5MB

# ---------- Database (PostgreSQL) ----------

# --- Option 1: Local Database (Docker) ---
# DB_URL=jdbc:postgresql://localhost:5432/lumiere
# DB_USER=postgres
# DB_PASS=your_db_password

# --- Option 2: Supabase ---
# Runtime URL - Transaction Pooler (port 6543), dùng cho HikariCP
DB_URL=your_supabase_runtime_url
# Migration URL - Session Pooler (port 5432), dùng cho Flyway
DB_MIGRATION_URL=your_supabase_migration_url
DB_USER=your_db_user
DB_PASS=your_db_password

# ---------- Security (JWT) ----------
# Must be long/random in production (>= 32 chars recommended)
JWT_SECRET=your_jwt_secret_min_256_bits

# ---------- QR settings ----------
QR_BASE_URL=http://localhost:3000/qr
QR_SESSION_EXPIRATION=1800000

# ---------- VNPay (optional) ----------
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_ENDPOINT=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:3000/payment-return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/webhooks/vnpay
VNPAY_COMMAND=pay
VNPAY_VERSION=2.1.0

# ---------- Cloudinary (optional) ----------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_MENU_FOLDER=lumiere/menu-items
CLOUDINARY_TABLE_QR_FOLDER=lumiere/table-qr
CLOUDINARY_MAX_FILE_SIZE_BYTES=5242880

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- AI service (optional) ----------
# Bật/tắt toàn bộ tích hợp AI. Đặt AI_ENABLED=false để tắt hoàn toàn khi không chạy ai-service.
AI_ENABLED=false
AI_RUNTIME_ENABLED=true
# URL của lumiere-ai-service (FastAPI). Mặc định port 8001 theo .env của ai-service.
AI_BASE_URL=http://localhost:8001
# Shared secret — phải khớp với AI_SERVICE_KEY trong .env của lumiere-ai-service
AI_SERVICE_KEY=your_ai_service_key

# Timeout (milliseconds) cho từng loại AI operation.
# Gemini API thường response trong 3-8s → chatbot cần buffer cao hơn các operation khác.
AI_TIMEOUT_SYNC_MENU_MS=5000
AI_TIMEOUT_RECOMMEND_MS=5000
AI_TIMEOUT_CHATBOT_MS=25000
AI_TIMEOUT_FORECAST_MS=10000
AI_TIMEOUT_COMBO_GENERATE_MS=15000
AI_TIMEOUT_BATCHING_MS=5000
AI_TIMEOUT_FEEDBACK_MS=3000
AI_TIMEOUT_RETRAIN_MS=5000
AI_TIMEOUT_JOB_STATUS_MS=3000

# Health check scheduler
AI_HEALTH_CHECK_ENABLED=true
AI_HEALTH_CHECK_INITIAL_DELAY_MS=10000
AI_HEALTH_CHECK_FIXED_DELAY_MS=30000

# Feedback flush interval (Phase 2 — CTR micro-batching, mặc định 5 phút)
AI_FEEDBACK_FLUSH_INTERVAL_MS=300000
