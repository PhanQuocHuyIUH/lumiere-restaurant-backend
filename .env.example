# ---------- Spring multipart limits ----------
SPRING_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_MULTIPART_MAX_REQUEST_SIZE=5MB

# ---------- Database (PostgreSQL) ----------

# --- Option 1: Local Database (Docker) ---
# DB_URL=jdbc:postgresql://localhost:5432/lumiere
# DB_USER=postgres
# DB_PASS=your_db_password

# --- Option 2: Supabase ---
# Runtime URL - Transaction Pooler (port 6543), dùng cho HikariCP
DB_URL=your_supabase_runtime_url
# Migration URL - Session Pooler (port 5432), dùng cho Flyway
DB_MIGRATION_URL=your_supabase_migration_url

# ---------- Security (JWT) ----------
# Must be long/random in production (>= 32 chars recommended)
JWT_SECRET=your_jwt_secret_min_256_bits

# ---------- QR settings ----------
QR_BASE_URL=http://localhost:3000/qr
QR_SESSION_EXPIRATION=1800000

# ---------- VNPay (optional) ----------
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_ENDPOINT=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:3000/payment-return
VNPAY_IPN_URL=http://localhost:8080/payments/webhooks/vnpay
VNPAY_COMMAND=pay
VNPAY_VERSION=2.1.0

# ---------- Cloudinary (optional) ----------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_MENU_FOLDER=lumiere/menu-items
CLOUDINARY_TABLE_QR_FOLDER=lumiere/table-qr
CLOUDINARY_MAX_FILE_SIZE_BYTES=5242880

# ---------- AI service (optional) ----------
AI_ENABLED=false
AI_RUNTIME_ENABLED=true
AI_BASE_URL=http://localhost:8000
AI_SERVICE_KEY=your_ai_service_key
AI_TIMEOUT_RECOMMEND_MS=500
AI_TIMEOUT_FORECAST_MS=2000
AI_TIMEOUT_ANOMALY_MS=1000
AI_TIMEOUT_CHATBOT_MS=1500
AI_TIMEOUT_BATCHING_MS=1200
AI_HEALTH_CHECK_ENABLED=true
AI_HEALTH_CHECK_INITIAL_DELAY_MS=5000
AI_HEALTH_CHECK_FIXED_DELAY_MS=15000
